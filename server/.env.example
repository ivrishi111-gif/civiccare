# ================= CIVICCARE server secrets =================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# NEVER commit the real .env file (it is in .gitignore).

# ---- Server ----
PORT=4000
# Public URL of the frontend (set to your Vercel URL in production, used for CORS)
CLIENT_URL=http://localhost:5173
# A long random string used to sign login tokens (e.g. 40+ random characters)
JWT_SECRET=change-me-to-a-long-random-string

# ---- Supabase (leave empty to run in DEMO MODE with an in-memory database) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Gemini (backend only — this key NEVER reaches the frontend) ----
# Any key format that Google AI Studio currently issues (older keys start with AIza,
# newer ones may have a different prefix — the app accepts both, no format check).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
