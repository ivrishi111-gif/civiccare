# Copy this file to .env and fill in your values:   cp .env.example .env
# NEVER share your .env file or push it to GitHub (it is in .gitignore).

# --- Port (local only) ---
PORT=4000

# --- Supabase (your free database) ---
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auth secret ---
# Any long random string. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Web address of the frontend (used for CORS) ---
# Local:  http://localhost:5173
# Live:   your Vercel URL
# You can list several, comma-separated (old + new links).
CLIENT_URL=http://localhost:5173

# --- AI (Gemini — backend only) ---
# https://aistudio.google.com/app/apikey
# NOTE: any current AI Studio key format works (old "AIza..." or current "AQ...").
# Leave empty for demo mode (suggestions become mock ones).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Base URL where sample before/after photos are served ---
# Local:  empty (photos are served from the same site)
# Live:   your Vercel URL, e.g. https://your-app.vercel.app
SAMPLE_BASE_URL=

# --- SMS provider for OTP ---
# mock (default, development): the OTP is shown on screen, no SMS provider needed.
# twilio (production): set the 4 TWILIO_* values and the OTP is sent by real SMS
# (and is never shown on screen).
SMS_PROVIDER=mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
